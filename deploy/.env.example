# Copy to deploy/.env on the Pi. Only needed when a default below is wrong.
# deploy/.env is gitignored; nothing here is a secret, and nothing that is one belongs here.

# Who owns the clone. The container writes sealed rounds into a bind-mounted checkout, so it runs
# as that user rather than as root — otherwise every file the loop writes is root-owned and the
# owner can no longer `git push` by hand. Defaults to 1000:1000, the first account on Raspberry Pi
# OS. Fill in from `id -u` and `id -g`.
PUID=1000
PGID=1000

# The clone to mount at /repo. The default is the parent of deploy/, which is right whenever
# compose is run from inside the clone — set it only if it is not.
# EPL_REPO=/home/pi/epl-predictor

# Where the deploy key lives. Mounted read-only; pushing is the whole of the container's business
# with it.
# SSH_DIR=/home/pi/.ssh
